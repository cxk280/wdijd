{
  "name": "wdijd",
  "version": "0.1.0",
  "description": "What Did I Just Do? — turn AI-written changes into flashcards you can actually explain",
  "type": "module",
  "bin": {
    "wdijd": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "author": "Christopher King <chris@cking.me>",
  "keywords": [
    "flashcards",
    "spaced-repetition",
    "fsrs",
    "ai",
    "code-review",
    "learning"
  ],
  "scripts": {
    "build": "vite build && tsup",
    "dev:web": "vite",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p src/web/tsconfig.json",
    "test": "vitest run",
    "prepublishOnly": "npm run test && npm run build"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "~0.3.170",
    "@clack/prompts": "^1.5.1",
    "@hono/node-server": "^2.0.4",
    "commander": "^15.0.0",
    "hono": "^4.12.25",
    "open": "^11.0.0",
    "ts-fsrs": "^5.4.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.5",
    "@types/node": "^25.9.2",
    "marked": "^18.0.5",
    "mermaid": "^11.15.0",
    "preact": "^10.29.2",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.8"
  }
}
